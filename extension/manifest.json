{
  "manifest_version": 3,
  "name": "Dato - AI Data-Leak Firewall",
  "version": "1.1.0",
  "description": "Checks prompts on ChatGPT, Claude and Gemini on your device, and warns, redacts or blocks confidential data before it sends. Best-effort, not a security boundary.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Dato",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [{
    "matches": [
      "https://chatgpt.com/*",
      "https://chat.openai.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*"
    ],
    "js": ["detectors.js", "policy.js", "adapters.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
